---
import ShareButton from "../../components/ShareButton.astro";
import Layout from "../../layouts/Layout.astro";
---
<Layout title="BoxPark Croydon — Croydon Tourist Board" description="Shipping containers full of food, drink, and festival energy.">
  <main class="container">
    <a class="back" href="/">&larr; Back to attractions</a>
    <h1>BoxPark Croydon</h1>
    <p class="lede">
      Shipping containers full of food, drink, and the unmistakable feeling that you are at
      a festival that never ends. Also the northern terminus of the Chicken Mile, for those
      keeping score.
    </p>
    <a class="cta" href="/attractions/chicken-mile">
      See where BoxPark fits on the Chicken Mile &rarr;
    </a>
    <ShareButton
      title="BoxPark Croydon — Croydon Tourist Board"
      text="Shipping containers, festival energy, and the start of the Chicken Mile."
    />
  </main>
</Layout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .back {
    color: var(--red-dark);
    text-decoration: none;
    font-weight: 700;
  }

  h1 {
    font-size: 2.5rem;
    color: var(--red);
    margin: 1rem 0;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--brown);
    margin-bottom: 1rem;
  }

  .cta {
    display: inline-block;
    margin-top: 1rem;
    background: var(--yellow);
    color: var(--dark);
    font-weight: 700;
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    text-decoration: none;
  }
</style>
