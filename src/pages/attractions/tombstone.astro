---
import ShareButton from "../../components/ShareButton.astro";
import Layout from "../../layouts/Layout.astro";
---
<Layout title="The World's Largest Tombstone — Croydon Tourist Board" description="Officially the Nestlé Tower. Unofficially, the most tombstone-shaped office block in Britain.">
  <main class="container">
    <a class="back" href="/">&larr; Back to attractions</a>
    <h1>The World's Largest Tombstone</h1>
    <p class="lede">
      Officially known as Norfolk House, and formerly the Nestlé Tower. Unofficially, and by
      popular local consensus, the single most tombstone-shaped office block ever erected on
      a British high street.
    </p>
    <p>
      Whether this was deliberate remains a matter of local legend. We choose to believe it was.
    </p>
    <ShareButton
      title="The World's Largest Tombstone — Croydon Tourist Board"
      text="Croydon has the world's largest tombstone. No, seriously."
    />
  </main>
</Layout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .back {
    color: var(--red);
    text-decoration: none;
    font-weight: 700;
  }

  h1 {
    font-size: 2.5rem;
    color: var(--red);
    margin: 1rem 0;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--brown);
    margin-bottom: 1rem;
  }

  p {
    margin-bottom: 1rem;
  }
</style>
