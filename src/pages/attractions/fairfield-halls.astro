---
import ShareButton from "../../components/ShareButton.astro";
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Fairfield Halls — Croydon Tourist Board" description="A genuinely lovely concert and arts venue, tastefully restored.">
  <main class="container">
    <a class="back" href="/">&larr; Back to attractions</a>
    <h1>Fairfield Halls</h1>
    <p class="lede">
      A genuinely lovely concert hall and arts venue, tastefully restored after a multi-year
      closure. Home to touring orchestras, comedians, and the occasional proof that Croydon
      does culture rather well.
    </p>
    <p>
      Yes, really. Not everything on this list is a cry for help.
    </p>
    <ShareButton
      title="Fairfield Halls — Croydon Tourist Board"
      text="Proof that Croydon does culture rather well. Yes, really."
    />
  </main>
</Layout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .back {
    color: var(--red-dark);
    text-decoration: none;
    font-weight: 700;
  }

  h1 {
    font-size: 2.5rem;
    color: var(--red);
    margin: 1rem 0;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--brown);
    margin-bottom: 1rem;
  }

  p {
    margin-bottom: 1rem;
  }
</style>
