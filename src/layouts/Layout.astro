---
interface Props {
	title?: string;
	description?: string;
}
const {
	title = "Croydon Tourist Board",
	description = "The official* guide to visiting Croydon. Home of the world's largest tombstone, a decaying shopping mall, and the greatest concentration of fried chicken shops on Earth.",
} = Astro.props;
const canonicalURL = new URL(
	Astro.url.pathname,
	"https://croydontouristboard.co.uk",
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Nunito:wght@400;700;900&display=swap" rel="stylesheet" crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav>
      <div class="container nav-inner">
        <a href="/" class="brand">Croydon Tourist Board</a>
      </div>
    </nav>

    <slot />

    <footer>
      <div class="container">
        <p class="footer-title">Croydon Tourist Board</p>
        <p>Proudly promoting Croydon since whenever we finished writing this website.</p>
        <p class="small-muted">
          Not an actual local authority body. Any resemblance to an official tourism organisation is entirely the point.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --red: #E8210A;
    --red-dark: #B01808;
    --yellow: #FFD000;
    --yellow-light: #FFF3A3;
    --orange: #FF7800;
    --cream: #FFF8EE;
    --dark: #1C0A00;
    --brown: #3D1C00;
    --white: #FFFDF8;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Nunito', sans-serif;
    background-color: var(--cream);
    color: var(--dark);
    overflow-x: hidden;
  }

  h1, h2, h3 {
    font-family: 'Bangers', cursive;
    letter-spacing: 0.04em;
  }

  footer {
    background-color: var(--dark);
    color: var(--cream);
    text-align: center;
    padding: 1.5rem 1rem;
    font-size: 0.9rem;
  }

  footer a {
    color: var(--yellow);
    text-decoration: none;
  }

  footer a:hover {
    text-decoration: underline;
  }
</style>

<style>
  nav {
    background: var(--dark);
    padding: 0.75rem 1.5rem;
  }

  .nav-inner {
    display: flex;
    align-items: center;
  }

  .brand {
    color: var(--cream);
    font-family: 'Bangers', cursive;
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  footer p {
    margin: 0.25rem 0;
  }

  .footer-title {
    font-family: 'Bangers', cursive;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
    color: var(--yellow);
  }

  .small-muted {
    opacity: 0.7;
    font-size: 0.8rem;
  }
</style>
