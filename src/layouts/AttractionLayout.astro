---
import Layout from "./Layout.astro";

interface Props {
	title: string;
	description: string;
	heading: string;
}

const { title, description, heading } = Astro.props;
---
<Layout title={title} description={description}>
  <main class="container">
    <a class="back" href="/">&larr; Back to attractions</a>
    <h1>{heading}</h1>
    <slot />
  </main>
</Layout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .back {
    color: var(--red-dark);
    text-decoration: none;
    font-weight: 700;
  }

  h1 {
    font-size: 2.5rem;
    color: var(--red);
    margin: 1rem 0;
  }

  :global(main.container .lede) {
    font-size: 1.15rem;
    color: var(--brown);
    margin-bottom: 1rem;
  }

  :global(main.container p) {
    margin-bottom: 1rem;
  }

  :global(main.container .cta) {
    display: inline-block;
    margin-top: 1rem;
    background: var(--yellow);
    color: var(--dark);
    font-weight: 700;
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    text-decoration: none;
  }
</style>
